# 이 파일을 복사해 .env 로 만든 뒤 값을 채우세요. (.env 는 .gitignore 로 커밋되지 않습니다)
# 이 예시 파일에는 실제 키를 절대 적지 마세요.

# --- AI (OpenAI 호환 키) ---
OPENAI_API_KEY=
# 코디세이 콘솔이 안내하는 base_url (OpenAI 서버가 아님). 콘솔 안내를 확인해서 채우세요.
OPENAI_BASE_URL=
# 콘솔이 지원하는 모델명을 확인해서 채우세요.
OPENAI_MODEL=

# --- Firebase (둘 중 하나만 채우세요) ---
# 로컬 개발: 프로젝트 폴더 밖에 보관한 서비스 계정 JSON 파일의 경로
FIREBASE_SERVICE_ACCOUNT_PATH=
# 배포(Render): JSON 파일 내용 전체를 한 줄 문자열로 넣는 환경변수 (로컬에서는 비워 두세요)
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- 서버/프론트 연결 ---
# 프론트가 호출할 백엔드 주소 (로컬 예시)
API_BASE_URL=http://localhost:8000
# CORS 허용 도메인 목록 (쉼표로 구분). 배포 후 Vercel 주소를 추가하세요.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- 채팅 보호 장치 (선택, 비우면 기본값) ---
# AI 답변 최대 토큰 수(과금 보호). 기본 500
CHAT_MAX_TOKENS=
# AI 응답 대기 제한 시간(초). 기본 30
CHAT_TIMEOUT_SECONDS=
# IP당 분당 채팅 횟수. 기본 10
CHAT_RATE_LIMIT_PER_MIN=
# 서버 전체 하루 채팅 횟수. 기본 300
CHAT_DAILY_LIMIT=
